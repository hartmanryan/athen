# nCino Webhook Secret for HMAC SHA-256 verification
# Set this to the secret key generated in nCino Company Settings > API Management > Webhooks
NCINO_WEBHOOK_SECRET=your_ncino_webhook_secret_here

# Thanks.io API Key (Bearer Token)
# Found in Thanks.io > Account Settings > API Access
THANKS_IO_API_KEY=your_thanksio_api_key_here

# Enable Thanks.io API Test Mode (true/false)
# When set to true, requests to Thanks.io are validated without incurring real charges
THANKS_IO_TEST_MODE=true

# Optional: Default Thanks.io Mailing List ID if milestone isn't explicitly matched
THANKS_IO_DEFAULT_MAILING_LIST_ID=

# Optional: Custom JSON mapping for Milestone Name -> Thanks.io Mailing List ID
# Format: JSON string mapping nCino milestone name to Thanks.io list ID
MILESTONE_MAPPING_JSON={"Clear to Close":"12345","Funded":"67890","Application Completed":"11223"}
